PORT=3001
NODE_ENV=development
DATABASE_URL=postgresql://user:password@localhost:5432/uslehne
JWT_SECRET=change-me-in-production
# Scaleway Object Storage (required)
S3_ENDPOINT=https://s3.fr-par.scw.cloud
S3_REGION=fr-par
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Brevo Transactional Email (required for password reset)
# SMTP user = your Brevo account email address
# SMTP key  = Settings > SMTP & API > SMTP Keys
BREVO_SMTP_USER=
BREVO_SMTP_KEY=
# Public URL used in email links (no trailing slash)
APP_URL=https://uslehne.ch
