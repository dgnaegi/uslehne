generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum OfferType {
  LEND
  GIVE
}

enum OfferCategory {
  KLEIDUNG
  MOEBEL
  HAUSHALT
  ELEKTROGERAETE
  KINDER
  BUECHER
  HOBBY
  ANDERE
}

enum OfferStatus {
  AVAILABLE
  LENT
  GIVEN
  ARCHIVED
}

enum TransactionStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
  RETURNED
  COMPLETED
}

enum LedgerReason {
  INVITE_BONUS
  INVITE_REWARD
  LEND_EARN
  BORROW_SPEND
  GIVE_EARN
  RECEIVE_SPEND
  ADMIN_ADJUST
}

enum ContactType {
  SMS
  WHATSAPP
  SIGNAL
  EMAIL
}

model User {
  id                  String               @id @default(cuid())
  username            String               @unique
  email               String               @unique
  passwordHash        String
  tokenVersion        Int                  @default(0)
  role                Role                 @default(USER)
  karmaBalance        Int                  @default(0)
  addresses           Address[]
  offers              Offer[]
  invitesCreated      Invite[]             @relation("InvitesCreated")
  inviteUsed          Invite?              @relation("InviteUsed")
  requests            Transaction[]        @relation("Requester")
  ownedTransactions   Transaction[]        @relation("Owner")
  ledger              KarmaLedger[]
  ratingsGiven        Rating[]             @relation("RatingsGiven")
  ratingsReceived     Rating[]             @relation("RatingsReceived")
  passwordResetTokens PasswordResetToken[]
  createdAt           DateTime             @default(now())
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  user      User      @relation(fields: [userId], references: [id])
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model Address {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  label     String?
  zip       String
  city      String?
  offers    Offer[]
  createdAt DateTime @default(now())

  @@unique([userId, zip])
  @@index([userId])
}

model Offer {
  id           String        @id @default(cuid())
  owner        User          @relation(fields: [ownerId], references: [id])
  ownerId      String
  title        String
  description  String
  type         OfferType
  category     OfferCategory
  status       OfferStatus   @default(AVAILABLE)
  imageRef     String
  address      Address       @relation(fields: [addressId], references: [id])
  addressId    String
  transactions Transaction[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([ownerId])
}

model Transaction {
  id           String            @id @default(cuid())
  offer        Offer             @relation(fields: [offerId], references: [id])
  offerId      String
  requester    User              @relation("Requester", fields: [requesterId], references: [id])
  requesterId  String
  owner        User              @relation("Owner", fields: [ownerId], references: [id])
  ownerId      String
  type         OfferType
  karma        Int
  status            TransactionStatus @default(PENDING)
  message           String?
  contactType       ContactType
  contactValue      String
  ownerConfirmed    Boolean           @default(false)
  requesterConfirmed Boolean          @default(false)
  ratings           Rating[]
  createdAt    DateTime          @default(now())
  decidedAt    DateTime?
  returnedAt   DateTime?

  @@index([ownerId, createdAt])
  @@index([requesterId, createdAt])
  @@index([offerId, status])
}

model Rating {
  id            String      @id @default(cuid())
  stars         Int
  raterId       String
  rater         User        @relation("RatingsGiven", fields: [raterId], references: [id])
  ratedId       String
  rated         User        @relation("RatingsReceived", fields: [ratedId], references: [id])
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id])

  @@unique([transactionId, raterId])
  @@index([ratedId])
  createdAt     DateTime    @default(now())
}

model Invite {
  id          String    @id @default(cuid())
  code        String    @unique
  createdBy   User      @relation("InvitesCreated", fields: [createdById], references: [id])
  createdById String
  karma       Int       @default(3)
  usedBy      User?     @relation("InviteUsed", fields: [usedById], references: [id])
  usedById    String?   @unique
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
}

model KarmaLedger {
  id            String       @id @default(cuid())
  user          User         @relation(fields: [userId], references: [id])
  userId        String
  delta         Int
  reason        LedgerReason
  transactionId String?
  createdAt     DateTime     @default(now())

  @@index([userId, createdAt])
}
