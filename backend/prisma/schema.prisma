generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum OfferType {
  LEND
  GIVE
}

enum OfferStatus {
  AVAILABLE
  LENT
  GIVEN
  ARCHIVED
}

enum TransactionStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
  RETURNED
  COMPLETED
}

enum LedgerReason {
  INVITE_BONUS
  LEND_EARN
  BORROW_SPEND
  GIVE_EARN
  RECEIVE_SPEND
  ADMIN_ADJUST
}

enum ContactType {
  SMS
  WHATSAPP
  SIGNAL
  EMAIL
}

model User {
  id                  String               @id @default(cuid())
  username            String               @unique
  email               String               @unique
  passwordHash        String
  role                Role                 @default(USER)
  kudosBalance        Int                  @default(0)
  addresses           Address[]
  offers              Offer[]
  invitesCreated      Invite[]             @relation("InvitesCreated")
  inviteUsed          Invite?              @relation("InviteUsed")
  requests            Transaction[]        @relation("Requester")
  ledger              KudoLedger[]
  ratingsGiven        Rating[]             @relation("RatingsGiven")
  ratingsReceived     Rating[]             @relation("RatingsReceived")
  passwordResetTokens PasswordResetToken[]
  createdAt           DateTime             @default(now())
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  user      User      @relation(fields: [userId], references: [id])
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model Address {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  label     String?
  zip       String
  city      String
  offers    Offer[]
  createdAt DateTime @default(now())

  @@index([userId])
}

model Offer {
  id           String        @id @default(cuid())
  owner        User          @relation(fields: [ownerId], references: [id])
  ownerId      String
  title        String
  description  String
  type         OfferType
  status       OfferStatus   @default(AVAILABLE)
  imageRef     String
  address      Address       @relation(fields: [addressId], references: [id])
  addressId    String
  transactions Transaction[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([ownerId])
}

model Transaction {
  id           String            @id @default(cuid())
  offer        Offer             @relation(fields: [offerId], references: [id])
  offerId      String
  requester    User              @relation("Requester", fields: [requesterId], references: [id])
  requesterId  String
  ownerId      String
  type         OfferType
  kudos        Int
  status            TransactionStatus @default(PENDING)
  message           String?
  contactType       ContactType
  contactValue      String
  ownerConfirmed    Boolean           @default(false)
  requesterConfirmed Boolean          @default(false)
  ratings           Rating[]
  createdAt    DateTime          @default(now())
  decidedAt    DateTime?
  returnedAt   DateTime?

  @@index([ownerId, createdAt])
  @@index([requesterId, createdAt])
  @@index([offerId, status])
}

model Rating {
  id            String      @id @default(cuid())
  stars         Int
  raterId       String
  rater         User        @relation("RatingsGiven", fields: [raterId], references: [id])
  ratedId       String
  rated         User        @relation("RatingsReceived", fields: [ratedId], references: [id])
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id])

  @@unique([transactionId, raterId])
  @@index([ratedId])
  createdAt     DateTime    @default(now())
}

model Invite {
  id          String    @id @default(cuid())
  code        String    @unique
  createdBy   User      @relation("InvitesCreated", fields: [createdById], references: [id])
  createdById String
  kudos       Int       @default(10)
  usedBy      User?     @relation("InviteUsed", fields: [usedById], references: [id])
  usedById    String?   @unique
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
}

model KudoLedger {
  id            String       @id @default(cuid())
  user          User         @relation(fields: [userId], references: [id])
  userId        String
  delta         Int
  reason        LedgerReason
  transactionId String?
  createdAt     DateTime     @default(now())

  @@index([userId, createdAt])
}
